{
 "spec_version": "1",
 "about": "Inputs for tamarket/scenario.py with its exact outputs, for testing a port of the arithmetic. Arithmetic on the inputs a council sets, never a forecast.",
 "formulae": {
  "gross_difference_per_year": "households_moved * price_gap_per_household_year",
  "void_cost_per_year": "households_moved * void_cost_per_household_year",
  "net_difference_per_year": "households_moved * (price_gap_per_household_year - void_cost_per_household_year)",
  "set_up_cost": "households_moved * setup_cost_per_household",
  "net_difference_over_term": "lease_term_years * households_moved * (price_gap_per_household_year - void_cost_per_household_year) - households_moved * setup_cost_per_household",
  "payback_years": "setup_cost_per_household / (price_gap_per_household_year - void_cost_per_household_year), only when the difference is above 0"
 },
 "rounding": "Each money result: sign(x) * floor(|x| + 0.5) on the unrounded value, computed in the order of the formulae in IEEE 754 double precision. payback_years: sign(x) * floor(|x| * 100 + 0.5) / 100, or null when the net difference per household-year is 0 or less. recovered_within_term: payback_years is not null and is at most lease_term_years.",
 "validation": "Errors are listed in the order of the required fields (households_moved, from_type, to_type, price_gap_per_household_year, setup_cost_per_household, void_cost_per_household_year, lease_term_years), then the checks on households_on_from_type (its own error, or households_moved over it), then every field that is not an input, sorted. A required field gives at most one error. A value is a number only when it is a finite number and not true or false.",
 "note_texts": {
  "never_recovered": "On these inputs the new homes cost the same or more each year once voids are counted, so the set-up cost is never recovered [Certain: arithmetic].",
  "not_recovered_in_term": "On these inputs the set-up cost is not recovered within the lease term [Certain: arithmetic].",
  "negative_gap": "A negative price gap means the new type costs more per household-year on your inputs [Certain]."
 },
 "max_lease_years": 30,
 "accommodation_types": [
  "bed_and_breakfast",
  "nightly_paid_self_contained",
  "hostels",
  "private_sector_leased",
  "la_ha_stock",
  "other"
 ],
